  {
   "id": "26faeb3d-b762-424d-9f4a-1744355d8e50",
   "name": "Prepare delivery",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    2860,
    300
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const c=$('Configuration').first().json,a=c.actorInput;\nconst run=$('Check run status').first().json,health=$('Get HEALTH').first().json;\nconst companies=$('Get COMPANIES').first().json.body,jobs=$input.first().json.body;\nif (!Array.isArray(jobs)||!Array.isArray(companies)||companies.length!==a.companies.length || companies.some(x=>x.status!=='ok') || a.companies.some(x=>!companies.some(y=>y.input===x)) || !Array.isArray(health.companiesFailed)||health.companiesFailed.length || health.companies!==companies.length || health.items!==jobs.length || jobs.length>a.maxItems || health.detailMissing>0 || run.stats?.restartCount>0) throw new Error('Incomplete or unreliable source response. Inspect HEALTH and COMPANIES; no rows written.');\nconst sorted=v=>Array.isArray(v)?[...v].sort():v;\nconst stable={};for(const k of Object.keys(a).sort())if(!['maxItems','maxItemsPerCompany','includeDescription','onlyNewSinceLastRun'].includes(k))stable[k]=sorted(a[k]);\nconst scope=JSON.stringify(stable);\nconst all=$('Read saved jobs').all().map(i=>i.json).filter(r=>r.key);\nconst keys=new Set();for(const r of all){if(keys.has(r.key))throw new Error('Duplicate saved key; fix Jobs before retrying.');keys.add(r.key);}\nconst existing=all.filter(r=>r.scope===scope),old=new Map(existing.map(r=>[r.key,r]));\nfor(const r of existing)if(!['baseline','logged'].includes(r.recordStatus))throw new Error('Invalid saved recordStatus.');\nconst baseline=existing.length===0&&c.baselineOnEmptyScope,now=new Date().toISOString(),rows=new Map(old),seen=new Set(),newIds=[];\nconst plain=v=>String(v??'');\nfor(const job of jobs){\n if(typeof job.id!=='string'||!job.id||!job.title||!/^https?:\\/\\//i.test(job.url||'')||seen.has(job.id))throw new Error('Missing job fields or duplicate source ID; no rows written.');\n seen.add(job.id);const key=scope+'|'+job.id,previous=old.get(key);if(!previous)newIds.push(job.id);\n rows.set(key,{key,scope,jobId:job.id,company:plain(job.company),ats:plain(job.ats),title:plain(job.title),locations:Array.isArray(job.locations)?job.locations.join(' | '):plain(job.locations),workplaceType:plain(job.workplaceType),salaryMin:plain(job.salaryMin),salaryMax:plain(job.salaryMax),salaryCurrency:plain(job.salaryCurrency),publishedAt:plain(job.publishedAt),url:job.url,firstSeenAt:previous?.firstSeenAt||now,lastSeenAt:now,runId:run.id,recordStatus:previous?.recordStatus||(baseline?'baseline':'logged')});\n}\nreturn [{json:{rows:[...rows.values()],baseline,newIds,runId:run.id,observedRows:jobs.length,coverage:jobs.length>=a.maxItems||companies.some(x=>x.matchedJobs>=a.maxItemsPerCompany)?'at-row-limit':'below-row-limit-not-proof-of-completeness'}}];"
   }
  },
