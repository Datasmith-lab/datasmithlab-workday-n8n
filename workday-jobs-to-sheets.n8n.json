    "jsCode": "return [{json:{\n spreadsheetId:'REPLACE_WITH_SPREADSHEET_ID', baselineOnEmptyScope:true,\n maxTotalChargeUsd:0.10,\n actorInput:{companies:['https://nvidia.wd5.myworkdayjobs.com/NVIDIAExternalCareerSite'],postedWithin:'any',includeDescription:false,\n onlyNewSinceLastRun:false,maxItems:10,maxItemsPerCompany:10}\n}}];"
