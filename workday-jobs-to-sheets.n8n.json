  {
   "id": "b9cee195-210d-4f25-b03e-dd63bd133672",
   "name": "Validate configuration",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    300
   ],
   "parameters": {
    "mode": "runOnceForAllItems",
    "jsCode": "const c=$input.first().json,a=c.actorInput;\nif (!c.spreadsheetId || c.spreadsheetId.startsWith('REPLACE_')) throw new Error('Set spreadsheetId.');\nif (!Array.isArray(a.companies)||!a.companies.length||a.companies.length>5||a.companies.some(x=>typeof x!=='string'||!x.trim())||new Set(a.companies).size!==a.companies.length) throw new Error('Use 1 to 5 distinct full myworkdayjobs.com board URLs.');\nif (a.companies.some(x=>!/^https:\\/\\/[a-z0-9-]+\\.wd\\d+\\.myworkdayjobs\\.com\\/[^\\s]+$/i.test(x.trim()))) throw new Error('Each company must be a full Workday board URL, for example https://nvidia.wd5.myworkdayjobs.com/NVIDIAExternalCareerSite.');\nif (a.onlyNewSinceLastRun!==false || !Number.isInteger(a.maxItems)||a.maxItems<1||a.maxItems>100 || !Number.isInteger(a.maxItemsPerCompany)||a.maxItemsPerCompany<1||a.maxItemsPerCompany>100) throw new Error('Use snapshots with tracking off and limits 1 to 100.');\nif (!Number.isFinite(c.maxTotalChargeUsd)||c.maxTotalChargeUsd<=0||c.maxTotalChargeUsd>1) throw new Error('Set a run charge cap above zero and no more than $1.');\nreturn [{json:c}];"
   }
  },
